{
  // AmbiDOA Lightning validation-only template (JSONC).
  // Use with:
  //   python AmbiDOA/lightning/train_lightning.py --config AmbiDOA/config_lightning_validate_template.jsonc --validate-only
  //
  // NOTE:
  // - This file contains comments, so treat it as a TEMPLATE.
  // - If your JSON parser rejects comments, copy to a .json file and remove comments.

  // -------------------- Dataset / DataLoader --------------------
  "manifest_path": "D:\\pm\\bb\\New_Dataset\\samples2locator_5001_regions_updated_manifest_400_samples_aug2.json",
  "audio_dir": "D:\\pm\\bb\\New_Dataset\\out",
  "batch_size": 64,
  "num_workers": 16,
  // Optional split-specific workers. On Windows, val_num_workers=0 is safer for large datasets.
  "train_num_workers": 16,
  "val_num_workers": 0,
  "val_ratio": 0.2,
  "split_seed": 42,
  "sr": 11025,
  "window_len_ms": 250,
  "dbfs_threshold": -80.0,
  "require_cuda": true,

  // -------------------- Model (MUST match checkpoint) --------------------
  "n_channels": 16,
  "d_model": 256,
  "nhead": 16,
  "num_layers": 8,
  "dim_feedforward": 1024,
  "max_sources": 12,
  "use_posenc": true,
  "dropout": 0.2,

  // -------------------- Loss / Metrics --------------------
  // Current pipeline supports only regression for count head.
  "count_loss_type": "regression",
  "lambda_count": 0.5,
  "lambda_pos": 2.5,
  "pos_loss_type": "cosine",

  // -------------------- Checkpoint --------------------
  // Used by --validate-only if --checkpoint is not provided.
  "finetune_from": "D:\\pm\\bb\\AmbiDOA\\models\\2026_02_26\\best_model_epoch=03_val_loss=0.2794.ckpt",

  // -------------------- Runtime / Performance --------------------
  "precision": "32-true",
  "matmul_precision": "highest",
  "log_every_n_steps": 50,
  "deterministic": false,
  "fast_dev_run": false,
  "num_sanity_val_steps": 0,

  // Optional timing diagnostics for validation runs.
  "log_timing": true,
  "timing_log_every_n_steps": 0,
  "timing_cuda_sync": false,
  // Keep all TXT logs in one file pinned to run start date.
  // null => auto name: log_AmbiDOA_<run-start-date>.txt
  "run_txt_log_name": null,
  // Prefix each TXT line with [YYYY-MM-DD HH:MM:SS].
  "run_txt_timestamp": true,

  // -------------------- Compatibility keys (ignored in validate-only mode) --------------------
  "num_epochs": 1,
  "lr": 0.0005,
  "finetune_lr": 0.0005,
  "reset_optimizer": true,
  "freeze_n_encoder_layers": 0,
  "freeze_posenc": false,
  "use_scheduler": true,
  "warmup_steps": null,
  "weight_decay": 0.0001,
  "grad_clip": 0.0,
  "accumulate_grad_batches": 1,
  "log_grad_norm": true,
  "use_ema": true,
  "ema_decay": 0.999,
  "ema_update_after_step": 0,
  "save_top_k": 1,
  "save_last": true,
  "log_lr": true,
  "early_stopping_patience": 0
}
