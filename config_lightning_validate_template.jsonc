{
  // AmbiDOA Lightning validation-only template (JSONC).
  // Use with:
  //   python AmbiDOA/lightning/train_lightning.py --config AmbiDOA/config_lightning_validate_template.jsonc --validate-only
  //
  // NOTE:
  // - This file contains comments, so treat it as a TEMPLATE.
  // - If your JSON parser rejects comments, copy to a .json file and remove comments.

  // -------------------- Dataset / DataLoader --------------------
  "manifest_path": "D:\\pm\\bb\\New_Dataset\\samples2locator_5001_regions_updated_manifest_400_samples_aug2.json",
  "audio_dir": "D:\\pm\\bb\\New_Dataset\\out",
  "batch_size": 64,
  "num_workers": 16,
  // Optional split-specific workers. On Windows, val_num_workers=0 is safer for large datasets.
  "train_num_workers": 16,
  "val_num_workers": 0,
  "val_ratio": 0.2,
  "split_seed": 42,
  "sr": 11025,
  "window_len_ms": 250,
  "dbfs_threshold": -80.0,
  "require_cuda": true,

  // -------------------- Model (MUST match checkpoint) --------------------
  "n_channels": 16,
  "d_model": 256,
  "nhead": 16,
  "num_layers": 8,
  "dim_feedforward": 1024,
  "max_sources": 12,
  "use_posenc": true,
  "dropout": 0.2,
  // Max DropPath rate at the final encoder layer (0 disables). For validate-only
  // runs against pre-stochastic-depth checkpoints keep this at 0.0 — the encoder
  // then falls back to nn.TransformerEncoder, bit-identical to the baseline.
  "stochastic_depth": 0.0,

  // count_head_hidden:
  //   true (legacy/default) -> 2-layer MLP head (~70K params).
  //   false -> single Linear(d_model -> count_out_dim) (~3K params). Reduces
  //   count-head capacity to memorize per-sample k from the [CLS] feature.
  //   NOTE: switching this value makes the count-head weights structurally
  //   incompatible with previous checkpoints — strict=False loaders will skip
  //   the head, reinitializing it from scratch.
  "count_head_hidden": true,

  // Readout A/B switch (quick-revert). This replaces ONLY the readout stage;
  // the encoder and the (presence, positions) output contract are unchanged, so
  // loss / PI-matching / EMA / mean-teacher / R-Drop are untouched.
  //   false (default) -> A: temporal mean-pool -> pooled presence + positions
  //          heads. Bit-identical to the pre-decoder baseline.
  //   true -> B: query decoder. max_sources learned slots cross-attend the
  //          encoder output (and self-attend to de-duplicate) and predict a
  //          per-slot direction + presence logit — lifts the mean-pool
  //          single-vector bottleneck on high source counts.
  //   Presence-only: requires count_loss_type = "presence" (rejected otherwise).
  //   Checkpoint compatibility: toggling this changes the readout parameter set
  //   (source_queries / decoder / slot heads vs pooled heads), so decoder-on and
  //   decoder-off checkpoints are NOT weight-compatible — strict=False loaders
  //   skip and reinitialize the readout.
  //   Training note: the decoder is DETR-style and less LR-tolerant than the
  //   mean-pool head — use grad_clip > 0 (it diverges unclipped at high LR), and
  //   expect slower convergence (more epochs / a gentler LR). The overfit sanity
  //   test auto-softens its LR, enables clipping, and raises its step budget when
  //   this is true.
  "use_query_decoder": false,
  "decoder_layers": 3,          // query-decoder depth (used only when use_query_decoder=true)
  "decoder_dropout": 0.1,       // dropout inside the decoder + slot heads, independent of encoder `dropout`

  // -------------------- Loss / Metrics --------------------
  // count_loss_type:
  //   "regression" — single scalar logit + SmoothL1 (legacy; can collapse toward
  //                  the dataset-mean k under prediction uncertainty).
  //   "ordinal"    — max_sources cumulative logits + BCE on P(k>=j). Inference
  //                  rounds the count as k_pred = sum_j 1{sigmoid(logit_j) > 0.5}.
  //   "presence"   — max_sources per-slot logits + BCE against the Hungarian
  //                  matched assignment (1 for slots that PI-matched a real
  //                  source, 0 otherwise). Count is structurally derived as
  //                  k_pred = sum_j 1{sigmoid(slot_logit_j) > 0.5}. Ties the
  //                  count and position heads to the same slot indices, so the
  //                  count cannot claim sources the position head cannot
  //                  localize. Requires count_consistency_weight = 0 and
  //                  count_per_k_weights = null (both undefined in this mode).
  // Checkpoint compatibility: switching between modes changes the count-head
  // output dim, so checkpoints across modes are not weight-compatible.
  "count_loss_type": "regression",
  "lambda_count": 0.5,
  "lambda_pos": 2.5,
  "pos_loss_type": "cosine",

  // count_label_smoothing (ordinal or presence):
  //   Replaces hard {0,1} BCE targets with {ε, 1-ε}. Attacks the val-BCE
  //   confidence-overfit drift seen on the 2026_06_27 run while count_mae and
  //   angular_error were stable. 0.0 disables (legacy behavior); 0.05 is a
  //   typical starting point; must be in [0.0, 0.5).
  //   Optimal BCE floor becomes -(1-ε)·log(1-ε) - ε·log(ε) (≈ 0.20 at ε=0.05).
  "count_label_smoothing": 0.0,

  // thresholded_loss_report (diagnostic/logging only — no effect on training,
  // checkpoint selection, or early stopping, all of which key off
  // val_angular_error_deg):
  //   false (default) -> train/base_loss and val_loss are the exact task loss
  //          (count BCE + position cosine). The count BCE up-drifts under
  //          confidence miscalibration even while count_mae / angular_error
  //          keep improving.
  //   true  -> the count term in BOTH train/base_loss and val_loss is computed
  //          with THRESHOLDED predictions (probabilities snapped to the
  //          label-smoothing confidence by the >0.5 decision) instead of the raw
  //          probabilities. Same BCE scale/units — so base_loss and val_loss stay
  //          comparable — but the count term moves only with the hard decisions,
  //          so it shows no confidence up-drift. train/loss still logs the true
  //          gradient magnitude; the raw BCE count term is still at val/loss_count.
  "thresholded_loss_report": false,

  // Count-from-positions consistency (Strategy #3, regression/ordinal only):
  //   Aux loss tying pred_count to the number of PI-matched position slots
  //   whose cos(pred, true) > cos_threshold. Pushes the count head not to
  //   claim sources the position head cannot localize. Weight 0 disables.
  //   Undefined in 'presence' mode (the presence head is already structurally
  //   coupled to the matched slots) — must be 0.0 there.
  "count_consistency_weight": 0.0,
  "count_consistency_cos_threshold": 0.5,

  // Per-k class balance weights on the ordinal count BCE (ordinal only).
  //   Alternative to a class-balanced sampler: reweights the BCE contribution
  //   of each sample by w_k based on its true source count k. Suggested
  //   formula w_k = 1 / sqrt(freq_k). Length must equal max_sources + 1
  //   (indices k = 0..max_sources); all entries non-negative. null disables.
  //   Applied in both train and val loss for apples-to-apples comparison.
  "count_per_k_weights": null,

  // -------------------- Checkpoint --------------------
  // Used by --validate-only if --checkpoint is not provided.
  "finetune_from": "D:\\pm\\bb\\AmbiDOA\\models\\2026_02_26\\best_model_epoch=03_val_loss=0.2794.ckpt",

  // -------------------- Runtime / Performance --------------------
  "precision": "32-true",
  "matmul_precision": "highest",
  "log_every_n_steps": 50,
  "deterministic": false,
  "fast_dev_run": false,
  "num_sanity_val_steps": 0,

  // Optional timing diagnostics for validation runs.
  "log_timing": true,
  "timing_log_every_n_steps": 0,
  "timing_cuda_sync": false,
  // Keep all TXT logs in one file pinned to run start date.
  // null => auto name: log_AmbiDOA_<run-start-date>.txt
  "run_txt_log_name": null,
  // Prefix each TXT line with [YYYY-MM-DD HH:MM:SS].
  "run_txt_timestamp": true,

  // -------------------- Compatibility keys (ignored in validate-only mode) --------------------
  "num_epochs": 1,
  "lr": 0.0005,
  "finetune_lr": 0.0005,
  "reset_optimizer": true,
  "freeze_n_encoder_layers": 0,
  "freeze_posenc": false,
  "use_scheduler": true,
  "warmup_steps": null,
  "weight_decay": 0.0001,
  "grad_clip": 0.0,
  "accumulate_grad_batches": 1,
  "log_grad_norm": true,
  "use_ema": true,
  "ema_decay": 0.999,
  "ema_update_after_step": 0,
  "save_top_k": 1,
  "save_last": true,
  "log_lr": true,
  "early_stopping_patience": 0
}
