{
  "_comment": "Fine-tune the best synthetic decoder model (2026_10_01 EMA, 6.90 deg test; corrected windowing, true 250 ms @ 8 kHz) on the REAL dataset to close the anechoic->reverberant gap. sr/window MUST match the base (8 kHz, 250 ms, T=2000). Freezes the first 6 encoder layers; adapts the last 2 + decoder + heads. Run: python lightning/train_lightning.py --config config_lightning_finetune_real.json",
  "data": {
    "manifest_path": "D:\\pm\\bb\\Real_Dataset_Frame_Push\\Real_Dataset_Frame_Push\\103_Whole_Manifest_ACN-SN3D_Real_Dataset.json",
    "audio_dir": "D:\\pm\\bb\\Real_Dataset_Frame_Push\\Real_Dataset_Frame_Push",
    "sr": 8000,
    "window_len_ms": 250,
    "dbfs_threshold": -80.0,
    "batch_size": 32,
    "num_workers": 8,
    "train_num_workers": 6,
    "val_num_workers": 4,
    "val_ratio": 0.2,
    "test_ratio": 0.1,
    "split_seed": 42
  },
  "model": {
    "n_channels": 16,
    "d_model": 192,
    "nhead": 8,
    "num_layers": 8,
    "dim_feedforward": 1024,
    "max_sources": 12,
    "use_posenc": true,
    "dropout": 0.4,
    "stochastic_depth": 0.2,
    "gradient_checkpointing": false,
    "compile_model": false,
    "compile_backend": "aot-eager",
    "decoder_layers": 3,
    "decoder_dropout": 0.15
  },
  "loss": {
    "lambda_count": 1.5,
    "lambda_pos": 5.0,
    "count_label_smoothing": 0.15,
    "thresholded_loss_report": true,
    "presence_threshold": 0.5
  },
  "optimizer": {
    "lr": 0.0001,
    "weight_decay": 0.15,
    "use_scheduler": true,
    "warmup_steps": 300,
    "grad_clip": 1.0,
    "accumulate_grad_batches": 2
  },
  "ema": {
    "use_ema": true,
    "ema_decay": 0.999,
    "ema_update_after_step": 100,
    "mean_teacher_weight": 0.5
  },
  "regularization": {
    "rdrop_weight": 0.5,
    "regularization_every_n_steps": 1
  },
  "finetune": {
    "finetune_from": "models/2026_10_01/best_ema_model.pth",
    "finetune_lr": 3e-05,
    "reset_optimizer": true,
    "freeze_n_encoder_layers": 6,
    "freeze_posenc": true
  },
  "training": {
    "num_epochs": 30,
    "early_stopping_patience": 5,
    "save_top_k": 1,
    "save_last": true,
    "checkpoint_monitor": "val_angular_error_deg",
    "checkpoint_monitor_mode": "min"
  },
  "hardware": {
    "require_cuda": true,
    "precision": "32-true",
    "matmul_precision": "high",
    "deterministic": false
  },
  "logging": {
    "log_lr": true,
    "log_grad_norm": true,
    "log_every_n_steps": 100,
    "run_txt_timestamp": true,
    "run_txt_log_name": null,
    "log_timing": false,
    "timing_log_every_n_steps": 0,
    "timing_cuda_sync": false
  },
  "debug": {
    "fast_dev_run": false,
    "overfit_dev_run": false,
    "num_sanity_val_steps": 0,
    "overfit_test_epochs": 50,
    "overfit_test_threshold": 0.2,
    "overfit_test_batch_size": 32,
    "subsample_pct": 100
  }
}
